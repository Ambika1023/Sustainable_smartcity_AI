# Database
DATABASE_URL=postgresql://smartcity:smartcity123@localhost:5432/smartcity_db

# JWT
SECRET_KEY=your-very-secret-key-change-this-in-production-must-be-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# First-time Super Admin Setup
SUPER_ADMIN_SETUP_SECRET=change-this-setup-secret-key
SUPER_ADMIN_SETUP_ENABLED=true

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# App
APP_NAME=Sustainable Smart City AI Assistant
APP_ENV=development
DEBUG=true
