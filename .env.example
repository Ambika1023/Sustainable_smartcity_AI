# Global Environment Configuration

# Database
POSTGRES_DB=smartcity_db
POSTGRES_USER=smartcity
POSTGRES_PASSWORD=smartcity123
DATABASE_URL=postgresql://smartcity:smartcity123@localhost:5432/smartcity_db

# JWT & Authentication
SECRET_KEY=change-this-secret-key-in-production-must-be-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Super Admin Initial Setup
SUPER_ADMIN_SETUP_SECRET=change-this-setup-secret-key
SUPER_ADMIN_SETUP_ENABLED=true

# CORS & Frontend
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_URL=http://localhost:8000

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Application
APP_NAME=Sustainable Smart City AI Assistant
APP_ENV=development
DEBUG=true

